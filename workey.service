[Unit]
Description=Workey PocketBase 扩展服务
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/workey
ExecStart=/home/exedev/workey/workey serve --http=0.0.0.0:8000
Restart=always
RestartSec=3
Environment=HOME=/home/exedev
Environment=WORKEY_DATA=/home/exedev/workey/pb_data

[Install]
WantedBy=multi-user.target
