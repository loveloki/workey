{
  "app": {
    "name": "workey",
    "description": "Workey - 工作管理应用",
    "buildType": "dockerfile",
    "dockerfile": "Dockerfile",
    "port": 8000,
    "healthCheck": {
      "path": "/",
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  },
  "environment": {
    "WORKEY_DATA": "/app/data"
  },
  "volumes": [
    {
      "source": "workey-data",
      "destination": "/app/data",
      "type": "named"
    }
  ],
  "resources": {
    "cpuLimit": "1000m",
    "memoryLimit": "512Mi",
    "cpuRequest": "100m",
    "memoryRequest": "128Mi"
  },
  "deployment": {
    "replicas": 1,
    "strategy": "RollingUpdate",
    "revisionHistoryLimit": 5
  }
}
